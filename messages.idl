//idlc -l c messages.idl
// Defines the DDS messages (Slide 7); idlc turns this file into messages.h
// and messages.c (Slide 9). The join and input/position messages follow the
// flow in Slide 11, Figures 4a and 4b

struct JoinRequest
{
	boolean b_dummy;
	// Random per-client value, echoed back in JoinResponse so each client
	// can tell its own response from the ones meant for other clients
	long int_nonce;
	// Credential presented for authentication: an HMAC of int_nonce under
	// the pre-shared key - see security.h
	// Length must match SECURITY_TOKEN_LEN in security.h
	char arr_token[32];
};

struct JoinResponse
{
	//IDL needs int width to be clearly defined
    long int_player_id;
	// Copied from the JoinRequest this is the answer to
	long int_nonce;
	// Encrypted copy of this message's payload - see security.h. The
	// server already authenticates the client via JoinRequest.arr_token;
	// this lets the client authenticate the response in return, so it
	// does not trust a player ID that did not come from a holder of the
	// shared key. Samples with len_cipher == 0 or a cipher that fails to
	// decrypt are dropped; arr_cipher size must match
	// SECURITY_CIPHERTEXT_LEN in security.h
	octet arr_cipher[64];
	unsigned long len_cipher;
};

struct Input
{
	// Keyed so each client's Input has its own instance/history slot in
	// the server's reader - otherwise all clients' writes would compete
	// for a single unkeyed instance and could overwrite one another
	// before the server reads them
	@key long int_player_id;
    char ch_direction;
	// Encrypted copy of this message's payload - see security.h
	// Samples with len_cipher == 0 or a cipher that fails to decrypt are
	// dropped; arr_cipher size must match SECURITY_CIPHERTEXT_LEN in
	// security.h
	octet arr_cipher[64];
	unsigned long len_cipher;
};

// Server -> clients: one cell of the floor changed owner.
// Keyed on the cell, so a topic with transient-local durability and
// keep-last-1 hands a late joiner the current owner of every cell.
// Grid size must match GRID_COLS/GRID_ROWS in grid_logic.h
struct CellClaimed
{
	@key long int_cell_x;
	@key long int_cell_y;
	// 0 = unclaimed, otherwise the player ID
	long int_owner_id;
	// Encrypted copy of this message's payload - see security.h
	// Samples with len_cipher == 0 or a cipher that fails to decrypt are
	// dropped; arr_cipher size must match SECURITY_CIPHERTEXT_LEN in
	// security.h
	octet arr_cipher[64];
	unsigned long len_cipher;
};

// Server -> clients: round timer and result, published about once a second
struct GameState
{
	// Time left in the round (the full round length until it starts)
	long int_seconds_left;
	// False while the server is waiting for enough players
	boolean b_started;
	boolean b_game_over;
	// Only meaningful once b_game_over is true; 0 = draw
	long int_winner_id;
	// Encrypted copy of this message's payload - see security.h
	// Samples with len_cipher == 0 or a cipher that fails to decrypt are
	// dropped; arr_cipher size must match SECURITY_CIPHERTEXT_LEN in
	// security.h
	octet arr_cipher[64];
	unsigned long len_cipher;
};

struct Position
{
	// Keyed so each player has their own instance/history slot in every
	// client's reader - otherwise all players' positions would share a
	// single unkeyed instance, and one player's update could silently
	// overwrite another's before a client reads it (seen as another
	// player's square lagging several tiles behind their claimed cells)
	@key long int_player_id;
	long int_x;
	long int_y;
	// Encrypted copy of this message's payload - see security.h
	// Samples with len_cipher == 0 or a cipher that fails to decrypt are
	// dropped; arr_cipher size must match SECURITY_CIPHERTEXT_LEN in
	// security.h
	octet arr_cipher[64];
	unsigned long len_cipher;
};
